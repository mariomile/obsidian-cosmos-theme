{
  "comment": "Asserzioni mobile (verify-mobile.sh v2: class-injection is-mobile/is-phone sul body, MAI EmulateMobile — il footgun plugin-Node è impossibile by design). Target: iPhone Pro Max. Engine Chromium: i gate CSS si testano qui, i bug WebKit-only sul device reale.",
  "assertions": [
    {
      "name": "class-injection attiva (is-phone)",
      "bodyClass": "is-phone",
      "expected": true
    },
    {
      "name": "token touch-min presente (44px HIG)",
      "selector": "body",
      "property": "--cosmos-touch-min",
      "expected": "44px"
    },
    {
      "name": "canvas Cosmos su phone (surface-0)",
      "resolveVar": "--background-primary",
      "expected": "rgb(20, 20, 20)"
    },
    {
      "name": "menu elevato su phone (surface-2)",
      "resolveVar": "--menu-background",
      "expected": "rgb(26, 26, 26)"
    },
    {
      "name": "scala superfici viva su phone",
      "resolveVar": "--cosmos-surface-1",
      "expected": "rgb(23, 23, 23)"
    }
  ]
}